{
    "name": "rotdrop/bav",
    "type": "library",
    "description": "BAV provides validation for German Bank Accounts (Konto)",
    "keywords": ["bank", "account", "bankaccount", "validation", "check", "konto"],
    "homepage": "http://github.com/rotdrop/bav/",
    "license": "WTFPL",
    "authors": [
        {
            "name": "Markus Malkusch",
            "email": "markus@malkusch.de",
            "homepage": "http://markus.malkusch.de",
            "role": "Developer"
        },
        {
            "name": "Markus Zierhut",
            "email": "markus@zierhut.net",
            "homepage": "https://markus.zierhut.name",
            "role": "Developer"
        },
        {
            "name": "Claus-Justus Heine",
            "email": "himself@claus-justus-heine.de",
            "homepage": "https://claus-justus-heine.de",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "rotdrop\\bav\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "rotdrop\\bav\\": "tests/classes/"
        }
    },
    "require": {
        "php": ">=8.3",
        "rotdrop/php-index": "dev-master"
    },
    "suggest": {
        "ext-PDO": "Allows storing bank information in a database",
        "ext-mbstring": "Enables UTF-8 support",
        "ext-dom": "Enables picking the download URI by xpath",
        "lib-curl": "Enables API for downloading the bank file",
        "doctrine/orm": "Version ^3.7 for the Doctrine ORM data backend (also requires symfony/cache ^7.4)"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "doctrine/orm": "^3.7",
        "symfony/cache": "^7.4"
    },
    "archive": {
        "exclude": ["/tests"]
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --testsuite integration",
        "test:cross-project": "phpunit --testsuite cross-project"
    },
    "bin": [
        "bin/bav-update.php",
        "bin/bav-install.php"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/rotdrop/php-index"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
